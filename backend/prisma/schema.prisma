generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum MedicalRecordEventType {
  DIAGNOSIS_ADDED
  DIAGNOSIS_REMOVED
  PRESCRIPTION_ADDED
  PRESCRIPTION_REMOVED
}

model MedicalWorker {
  id        Int                  @id @default(autoincrement())
  firstName String               @db.VarChar(24)
  lastName  String               @db.VarChar(24)
  position  String               @db.VarChar(24)
  isDeleted Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  events    MedicalRecordEvent[]
}

model Diagnosis {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.Char(6)
  name      String   @unique @db.VarChar(24)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id            Int            @id @default(autoincrement())
  firstName     String         @db.VarChar(50)
  lastName      String         @db.VarChar(50)
  middleName    String?        @db.VarChar(50)
  birthDate     DateTime       @db.Date
  sex           Sex            @default(UNKNOWN)
  comment       String?        @db.VarChar(32)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  medicalRecord MedicalRecord?
}

model MedicalRecord {
  id        Int                  @id @default(autoincrement())
  patientId Int                  @unique
  createdAt DateTime             @default(now())
  patient   Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  events    MedicalRecordEvent[]
}

model MedicalRecordEvent {
  id              Int                    @id @default(autoincrement())
  medicalRecordId Int
  version         Int
  workerId        Int
  type            MedicalRecordEventType
  payload         Json
  createdAt       DateTime               @default(now())
  medicalRecord   MedicalRecord          @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  worker          MedicalWorker          @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@unique([medicalRecordId, version])
  @@index([workerId])
}
