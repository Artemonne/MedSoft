generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum MedicalRecordEventType {
  DIAGNOSIS_ADDED
  DIAGNOSIS_REMOVED
  PRESCRIPTION_ADDED
  PRESCRIPTION_REMOVED
}

enum MedicalWorkerRole {
  DOCTOR                @map("doctor")
  LABORATORY_TECHNICIAN @map("laboratory-technician")
  NURSE                 @map("nurse")
  OTHER                 @map("other")
}

enum AuditActorType {
  ADMIN
  USER
  SERVICE
  ANONYMOUS
  SYSTEM
}

enum AdministratorSetupState {
  PASSWORD_SETUP_REQUIRED
  TOTP_SETUP_REQUIRED
  ACTIVE
}

enum RefreshSessionSubjectType {
  ADMIN
  USER
  SERVICE
}

enum ServiceAccountRole {
  LIS
  HL7_IMPORT
}

enum LabResultKind {
  TEXT
  QUANTITY
}

model MedicalWorker {
  id        Int                  @id @default(autoincrement())
  firstName String               @db.VarChar(24)
  middleName String?             @db.VarChar(24)
  lastName  String               @db.VarChar(24)
  position  String               @db.VarChar(24)
  role      MedicalWorkerRole    @default(OTHER)
  isDeleted Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  account   Account?
  events    MedicalRecordEvent[]
  labOrderBatches LabOrderBatch[]
}

model Account {
  id              String           @id @default(uuid()) @db.Uuid
  username        String           @unique @db.VarChar(32)
  passwordHash    String
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  medicalWorkerId Int?             @unique
  medicalWorker   MedicalWorker?   @relation(fields: [medicalWorkerId], references: [id], onDelete: SetNull)
  auditEvents     AuditEvent[]
  refreshSessions RefreshSession[]
  labOrderBatches LabOrderBatch[]
}

model SystemAdministrator {
  id              Int                     @id @default(1)
  passwordHash    String?
  totpSecret      String?
  setupState      AdministratorSetupState @default(PASSWORD_SETUP_REQUIRED)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  auditEvents     AuditEvent[]
  refreshSessions RefreshSession[]
}

model ServiceAccount {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @unique @db.VarChar(100)
  keyId           String             @unique @db.VarChar(32)
  apiKeyHash      String             @db.VarChar(128)
  keyVersion      Int                @default(1)
  role            ServiceAccountRole @default(LIS)
  isActive        Boolean            @default(true)
  rotatedAt       DateTime            @default(now())
  lastUsedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  refreshSessions RefreshSession[]
  auditEvents     AuditEvent[]
  labResults      LabResult[]
  medicalRecordEvents MedicalRecordEvent[]
}

model AuditEvent {
  id                    String               @id @default(uuid()) @db.Uuid
  occurredAt            DateTime             @default(now())
  eventType              String               @default("LEGACY") @db.VarChar(64)
  actorType             AuditActorType
  actorIdentifier       String               @db.VarChar(128)
  message               String
  metadata               Json?
  accountId             String?              @db.Uuid
  systemAdministratorId Int?
  serviceAccountId      String?              @db.Uuid
  account               Account?             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  systemAdministrator   SystemAdministrator? @relation(fields: [systemAdministratorId], references: [id], onDelete: Restrict)
  serviceAccount        ServiceAccount?      @relation(fields: [serviceAccountId], references: [id], onDelete: Restrict)

  @@index([occurredAt, id])
  @@index([actorType, actorIdentifier])
  @@index([accountId])
  @@index([systemAdministratorId])
  @@index([serviceAccountId])
}

model RefreshSession {
  id                    String                    @id @default(uuid()) @db.Uuid
  subjectType           RefreshSessionSubjectType
  accountId             String?                   @db.Uuid
  systemAdministratorId Int?
  serviceAccountId      String?                   @db.Uuid
  tokenHash             String                    @unique
  familyId              String                    @db.Uuid
  issuedAt              DateTime                  @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?
  revocationReason      String?                   @db.VarChar(128)
  replacedById          String?                   @unique @db.Uuid
  account               Account?                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  systemAdministrator   SystemAdministrator?      @relation(fields: [systemAdministratorId], references: [id], onDelete: Cascade)
  serviceAccount        ServiceAccount?           @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  replacedBy            RefreshSession?           @relation("RefreshSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces              RefreshSession?           @relation("RefreshSessionRotation")

  @@index([accountId])
  @@index([systemAdministratorId])
  @@index([serviceAccountId])
  @@index([familyId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model Diagnosis {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.Char(6)
  name      String   @unique @db.VarChar(160)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Patient {
  id               Int            @id @default(autoincrement())
  firstName        String         @db.VarChar(50)
  lastName         String         @db.VarChar(50)
  middleName       String?        @db.VarChar(50)
  birthDate        DateTime       @db.Date
  sex              Sex            @default(UNKNOWN)
  comment          String?        @db.VarChar(32)
  externalIdSource String?        @db.VarChar(100)
  externalIdValue  String?        @db.VarChar(100)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  medicalRecord    MedicalRecord?

  @@unique([externalIdSource, externalIdValue])
}

model MedicalRecord {
  id              Int                  @id @default(autoincrement())
  patientId       Int                  @unique
  isEditingLocked Boolean              @default(true)
  createdAt       DateTime             @default(now())
  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  events          MedicalRecordEvent[]
  labOrderBatches LabOrderBatch[]
}

model LabTest {
  id                Int           @id @default(autoincrement())
  name              String        @db.VarChar(160)
  loincCode         String        @unique @db.VarChar(16)
  resultKind        LabResultKind
  unitCode          String?       @db.VarChar(32)
  unitDisplay       String?       @db.VarChar(64)
  methodDescription String?       @db.VarChar(160)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  orders            LabOrder[]
}

model LabOrderBatch {
  id                 String        @id @default(uuid()) @db.Uuid
  medicalRecordId    Int
  requesterId        Int
  createdByAccountId String        @db.Uuid
  idempotencyKey     String        @db.Uuid
  requestHash        String        @db.Char(64)
  createdAt          DateTime      @default(now())
  medicalRecord      MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  requester          MedicalWorker @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  createdByAccount   Account       @relation(fields: [createdByAccountId], references: [id], onDelete: Restrict)
  orders             LabOrder[]

  @@unique([createdByAccountId, idempotencyKey])
  @@index([medicalRecordId])
  @@index([requesterId])
}

model LabOrder {
  id                        String        @id @default(uuid()) @db.Uuid
  batchId                   String        @db.Uuid
  labTestId                 Int
  testNameSnapshot          String        @db.VarChar(160)
  loincCodeSnapshot         String        @db.VarChar(16)
  resultKindSnapshot        LabResultKind
  unitCodeSnapshot          String?       @db.VarChar(32)
  unitDisplaySnapshot       String?       @db.VarChar(64)
  methodDescriptionSnapshot String?       @db.VarChar(160)
  orderedAt                 DateTime      @default(now())
  batch                     LabOrderBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  labTest                   LabTest       @relation(fields: [labTestId], references: [id], onDelete: Restrict)
  result                    LabResult?

  @@index([batchId])
  @@index([labTestId])
}

model LabResult {
  id            String        @id @default(uuid()) @db.Uuid
  labOrderId    String        @unique @db.Uuid
  resultKind    LabResultKind
  textValue     String?       @db.Text
  quantityValue Decimal?      @db.Decimal(18, 6)
  unitCode      String?       @db.VarChar(32)
  effectiveAt   DateTime
  registeredAt  DateTime      @default(now())
  identifierSystem String?     @db.VarChar(255)
  identifierValue  String?     @db.VarChar(128)
  createdByServiceAccountId String? @db.Uuid
  labOrder      LabOrder      @relation(fields: [labOrderId], references: [id], onDelete: Restrict)
  createdByServiceAccount ServiceAccount? @relation(fields: [createdByServiceAccountId], references: [id], onDelete: Restrict)

  @@unique([identifierSystem, identifierValue])
  @@index([registeredAt])
  @@index([createdByServiceAccountId])
}

model MedicalRecordEvent {
  id               Int                    @id @default(autoincrement())
  medicalRecordId  Int
  version          Int
  workerId         Int?
  serviceAccountId String?                @db.Uuid
  type             MedicalRecordEventType
  payload          Json
  createdAt        DateTime               @default(now())
  medicalRecord    MedicalRecord          @relation(fields: [medicalRecordId], references: [id], onDelete: Restrict)
  worker           MedicalWorker?         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  serviceAccount   ServiceAccount?        @relation(fields: [serviceAccountId], references: [id], onDelete: Restrict)

  @@unique([medicalRecordId, version])
  @@index([workerId])
  @@index([serviceAccountId])
}
