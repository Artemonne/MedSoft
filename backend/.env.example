DATABASE_URL="postgresql://postgres:password@localhost:5432/his?schema=public"
FHIR_PUBLIC_BASE_URL="https://localhost:3001/api/fhir/r5"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ISSUER="medsoft-api"
JWT_AUDIENCE="medsoft-client"
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_BLOCK_SECONDS=900
ADMIN_BOOTSTRAP_MAX_ATTEMPTS=5
ADMIN_BOOTSTRAP_WINDOW_SECONDS=300
ADMIN_BOOTSTRAP_BLOCK_SECONDS=900
HL7_MLLP_HOST="127.0.0.1"
HL7_MLLP_PORT=2575
HL7_MLLP_TLS_KEY_PATH="../certificates/local/server.key.pem"
HL7_MLLP_TLS_CERT_PATH="../certificates/local/server.cert.pem"
HL7_MLLP_CLIENT_CA_PATH="../certificates/local/ca.cert.pem"
HL7_MLLP_MAX_MESSAGE_BYTES=102400
HL7_MLLP_IDLE_TIMEOUT_MS=10000
